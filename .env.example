# Database (Neon in production; local Postgres for development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextnest?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nextnest?schema=public"

# Auth: signs the session cookie (required in production). AUTH_URL builds magic-link URLs.
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Comma-separated .edu emails that get the review queue and analytics.
ADMIN_EMAILS=""

# Email: without a key, sign-in links are logged to the server console (and shown on the page in dev).
# DEMO_SHOW_SIGNIN_LINK=true also shows the link on a deployment. Anyone could then sign in as any
# supported .edu address, so only use it on protected demo deployments, and remove it once email works.
DEMO_SHOW_SIGNIN_LINK=""
RESEND_API_KEY=""
EMAIL_FROM="NextNest <onboarding@resend.dev>"

# Scam detection (Claude path). Without a key, heuristics alone decide.
ANTHROPIC_API_KEY=""
ANTHROPIC_SCAM_MODEL="claude-opus-5-5"
# Experiment 3: hold listings whose Claude risk score is above this (spec default 70).
SCAM_CLAUDE_THRESHOLD="70"

# Optional: forward events to PostHog in addition to the events table.
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# Later phases (not wired yet)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
DOCUSIGN_CLIENT_ID=""
DOCUSIGN_CLIENT_SECRET=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_BASE_PATH=""
